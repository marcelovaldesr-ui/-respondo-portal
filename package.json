{
  "name": "respondo-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Portal del cliente de Respondo — cada pyme ve a sus empleados IA trabajando (lee del schema ed_ del motor 2.0).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:integracion": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --env-file=.env.local --import ./tests-integracion/soporte/registrar.mjs --test tests-integracion/*.integracion.test.mjs",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
